<%- if main_app? -%>
class RunsController < ::ResourceController
  # The controller's name doesn't match Run's real, namespaced class
  # (Plutonium::Interaction::Run), so inference can't find it on its own.
  controller_for ::Plutonium::Interaction::Run
end
<%- else -%>
class <%= app_namespace %>::RunsController < ::<%= app_namespace %>::ResourceController
  # The controller's name doesn't match Run's real, namespaced class
  # (Plutonium::Interaction::Run), so inference can't find it on its own.
  controller_for ::Plutonium::Interaction::Run

  include <%= app_namespace %>::Concerns::Controller
end
<%- end -%>
