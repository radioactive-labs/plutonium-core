<%= render Plutonium::UI::Layout::IconRail.new(
      menu: Phlexi::Menu::Builder.new do |m|
        m.item t("plutonium.resource.nav.home"), url: root_path, icon: Phlex::TablerIcons::Home

        dashboards = registered_dashboards.reject { |dashboard| dashboard_path_for(dashboard) == root_path }
        if dashboards.any?
          m.item t("plutonium.resource.nav.dashboards"), icon: Phlex::TablerIcons::LayoutDashboard do |n|
            dashboards.each do |dashboard|
              n.item dashboard.label, url: dashboard_path_for(dashboard), icon: dashboard.icon
            end
          end
        end

        m.item t("plutonium.resource.nav.resources"), icon: Phlex::TablerIcons::GridDots do |n|
          registered_resources.each do |resource|
            n.item resource_label(resource), url: resource_url_for(resource, parent: nil)
          end
        end
      end
    ) do |rail| %>
  <% if respond_to?(:resource_logo_tag) %>
    <% rail.with_brand do %>
      <%= resource_logo_tag(classname: "h-8 w-8 rounded-md") %>
    <% end %>
  <% end %>
<% end %>
